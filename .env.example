# ── Claude (IA que entende as mensagens) ── https://console.anthropic.com
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# ── WhatsApp Cloud API (Meta) ── https://developers.facebook.com
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=invente-uma-senha-qualquer

# Seu(s) número(s), com DDI e DDD, separados por vírgula. Só eles são atendidos.
ALLOWED_NUMBERS=5511999999999

# ── Banco (Upstash Redis via Vercel Marketplace — preenchido automaticamente) ──
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Senha para o app ler os gastos (cole na aba Finanças → Assistente no WhatsApp)
APP_TOKEN=gere-um-token-longo-e-aleatorio

# TIMEZONE=America/Sao_Paulo
